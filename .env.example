# Fichier de configuration Docker avec variables d'environnement
# Copier ce fichier vers .env et modifier les valeurs

# Token du bot Discord
DISCORD_TOKEN=votre_token_discord_ici

# Clé API OpenWeatherMap
OPENWEATHER_API_KEY=votre_cle_api_openweathermap_ici

# URLs de base pour l'API OpenWeatherMap (optionnelles, valeurs par défaut)
BASE_URL=http://api.openweathermap.org/data/2.5/weather?
BASE_URL_FORECAST=http://api.openweathermap.org/data/2.5/forecast?
